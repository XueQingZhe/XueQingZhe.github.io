---
import Base from '../../layouts/Base.astro';
import LivingScene from '../../components/LivingScene.astro';
import CategoryFilter from '../../components/CategoryFilter.astro';
import '../../styles/editorial-pages.css';
import { tutorials,noteUrl,articleSeries,articleOrder,categoryCounts,type ArticleEntry } from '../../lib/content';
import { labelOf } from '../../data/taxonomy';
const chapters=await tutorials();
const grouped=new Map<string,ArticleEntry[]>();
for(const entry of chapters){const name=articleSeries(entry);if(!grouped.has(name))grouped.set(name,[]);grouped.get(name)!.push(entry);}
const groups=[...grouped].map(([name,items])=>{
  items.sort((a,b)=>articleOrder(a)-articleOrder(b)||a.data.date.valueOf()-b.data.date.valueOf()||a.data.title.localeCompare(b.data.title,'zh-CN'));
  const engines=[...new Set(items.flatMap(entry=>entry.data.engine))].map(engine=>labelOf('engine',engine));
  const tech=[...new Set(items.flatMap(entry=>entry.data.tech))].map(tag=>labelOf('tech',tag));
  return {id:name?`series-${name}`:'independent-study',name:name||'独立研习',items,engine:engines.join(' / ')||'STUDY SERIES',tech,order:Math.min(...items.map(articleOrder))};
}).sort((a,b)=>a.order-b.order||a.name.localeCompare(b.name,'zh-CN'));
const categories=categoryCounts(groups.flatMap(group=>group.items));
const tags=[...new Set(groups.flatMap(group=>group.items.flatMap(n=>n.data.tech)))].sort((a,b)=>a.localeCompare(b,'zh-CN'));
// Retain the previously published bookmark without assigning special layout or grouping rules.
const legacySeriesAnchors:Record<string,string>={'我独自升级':'solo'};
---
<Base title="学习系列" description="从基础知识到角色渲染，沿着系列文章一起学习与实践。">
  <header class="page-stage orbit-stage">
    <LivingScene variant="study"/><div class="stage-scrim" aria-hidden="true"></div>
    <svg class="orbit-art" viewBox="0 0 540 460" aria-hidden="true"><circle class="orbit-ring" cx="270" cy="230" r="70"/><ellipse class="orbit-ring" cx="270" cy="230" rx="205" ry="140" transform="rotate(-24 270 230)"/><ellipse class="orbit-ring orbit-faint" cx="270" cy="230" rx="210" ry="190" transform="rotate(35 270 230)"/><g class="orbit-satellite"><circle cx="270" cy="160" r="4"/></g><g class="orbit-satellite orbit-satellite-slow"><circle cx="270" cy="42" r="3"/></g><circle class="orbit-core" cx="270" cy="230" r="8"/></svg>
    <div class="orbit-copy"><span class="stage-index">03 / KNOWLEDGE IN MOTION</span><h1 data-kinetic data-kinetic-style="wide">ORBIT</h1><p class="stage-subtitle" data-kinetic data-kinetic-style="ink">学习轨道</p><p class="orbit-description">知识不是一条直线。<br/>从任意一个好奇的起点，开始环行。</p><div class="orbit-totals" data-series-totals><span><strong>{String(groups.length).padStart(2,'0')}</strong> 个系列</span><span><strong>{String(chapters.length).padStart(2,'0')}</strong> 篇记录</span></div></div>
    <nav class="series-atlas" aria-label="选择学习系列" data-series-atlas>
      <div class="atlas-heading"><span>选择一条轨道</span><small>EXPLORE THE SERIES</small></div>
      {groups.length>0?<ol>{groups.map((group,index)=><li><a class="series-portal" href={`#${group.id}`} data-series-portal={group.id}><span class="portal-order">{String(index+1).padStart(2,'0')}</span><div><h2>{group.name}</h2><p>{group.engine}</p></div><span class="portal-count">{group.items.length}<small>篇</small></span></a></li>)}</ol>:<p class="atlas-empty" data-series-empty>新的研习轨道正在酝酿。<br/>整理好的系列会从这里展开。</p>}
    </nav>
  </header>
  <div data-study-index>
    <nav class="series-navigation" aria-label="学习系列快捷目录"><span>选择一条轨道 · {groups.length} 个系列</span>{groups.map(group=><a href={`#${group.id}`} data-series-link={group.id}>{group.name}</a>)}</nav>
    <CategoryFilter categories={categories} total={groups.reduce((sum,g)=>sum+g.items.length,0)}/>
    {tags.length>0&&<div class="editorial-filter study-tags" role="group" aria-label="按标签筛选研习"><button type="button" data-study-tag="" aria-pressed="true">全部标签</button>{tags.map(tag=><button type="button" data-study-tag={tag} aria-pressed="false">{labelOf('tech',tag)}</button>)}</div>}
    <div class="editorial-result"><p class="study-result" role="status" aria-live="polite">共 {groups.reduce((sum,g)=>sum+g.items.length,0)} 篇研习记录</p><button type="button" class="editorial-reset" data-study-reset hidden>清除筛选</button></div>
    <p class="editorial-empty" data-study-empty hidden>这组子栏目与标签下还没有研习记录。可以清除筛选后再看看。</p>
    {groups.map((group,index)=><section class="series" id={group.id} data-study-series aria-labelledby={`series-heading-${index}`}>
      {legacySeriesAnchors[group.name]&&<span class="legacy-series-anchor" id={legacySeriesAnchors[group.name]} aria-hidden="true"></span>}
      <div class="series-intro"><span class="eyebrow">{String(index+1).padStart(2,'0')} / {group.engine}</span><h2 id={`series-heading-${index}`} data-kinetic>{group.name}</h2><p>{group.tech.length?group.tech.join(' · '):'由相连的实践与思考组成，按章节顺序阅读。'}</p><span class="series-count">{String(group.items.length).padStart(2,'0')} 篇研习记录</span></div><ol>{group.items.map((n,i)=><li data-reveal data-study-entry data-category={n.data.category} data-tech={JSON.stringify(n.data.tech)}><a href={noteUrl(n)}><span class="chapter-number">{String(i+1).padStart(2,'0')}</span><span class="chapter-title">{n.data.title}{n.data.tech.length>0&&<small class="chapter-tags">{n.data.tech.map(tag=>labelOf('tech',tag)).join(' · ')}</small>}</span></a></li>)}</ol></section>)}
  </div>
</Base>
<script>
  const index=document.querySelector<HTMLElement>('[data-study-index]');
  if(index){
    const buttons=[...index.querySelectorAll<HTMLButtonElement>('[data-study-tag]')];
    const categoryButtons=[...index.querySelectorAll<HTMLButtonElement>('button[data-category]')];
    const reset=index.querySelector<HTMLButtonElement>('[data-study-reset]')!;
    const entries=[...index.querySelectorAll<HTMLElement>('[data-study-entry]')];
    const groups=[...index.querySelectorAll<HTMLElement>('[data-study-series]')];
    const results=index.querySelector<HTMLElement>('.study-result')!;
    const empty=index.querySelector<HTMLElement>('[data-study-empty]')!;
    let tag='',category='';
    function read(){const params=new URLSearchParams(location.search);const requested=params.get('tag')||'';tag=buttons.some(button=>button.dataset.studyTag===requested)?requested:'';const requestedCategory=params.get('category')||'';category=categoryButtons.some(button=>button.dataset.category===requestedCategory)?requestedCategory:'';}
    function apply(sync=false){
      let shown=0;
      for(const entry of entries){entry.hidden=(!!category&&entry.dataset.category!==category)||(!!tag&&!JSON.parse(entry.dataset.tech||'[]').includes(tag));if(!entry.hidden)shown++;}
      for(const group of groups){const count=[...group.querySelectorAll<HTMLElement>('[data-study-entry]')].filter(entry=>!entry.hidden).length;group.hidden=count===0;group.querySelector('.series-count')!.textContent=`${String(count).padStart(2,'0')} 篇研习记录`;const link=[...index!.querySelectorAll<HTMLAnchorElement>('[data-series-link]')].find(link=>link.dataset.seriesLink===group.id);if(link)link.hidden=count===0;}
      for(const button of buttons)button.setAttribute('aria-pressed',String(button.dataset.studyTag===tag));
      for(const button of categoryButtons)button.setAttribute('aria-pressed',String(button.dataset.category===category));
      reset.hidden=!tag&&!category;
      results.textContent=shown===entries.length?`共 ${shown} 篇研习记录`:`找到 ${shown} / ${entries.length} 篇研习记录`;empty.hidden=shown>0;
      if(sync){const url=new URL(location.href);category?url.searchParams.set('category',category):url.searchParams.delete('category');tag?url.searchParams.set('tag',tag):url.searchParams.delete('tag');history.replaceState(null,'',url);}
      document.dispatchEvent(new CustomEvent('site:layout'));
    }
    for(const button of buttons)button.addEventListener('click',()=>{tag=button.dataset.studyTag||'';apply(true);});
    for(const button of categoryButtons)button.addEventListener('click',()=>{category=button.dataset.category||'';apply(true);});
    reset.addEventListener('click',()=>{tag='';category='';apply(true);});
    for(const link of document.querySelectorAll<HTMLAnchorElement>('[data-series-portal]'))link.addEventListener('click',()=>{if(tag||category){tag='';category='';apply(true);}});
    addEventListener('popstate',()=>{read();apply();});read();apply();
  }
</script>
<style>
  .orbit-stage{position:relative;display:grid;grid-template-columns:minmax(0,.8fr) minmax(0,1.25fr);gap:clamp(30px,5vw,70px);align-items:center;min-height:480px;padding:55px 45px;margin-top:24px;isolation:isolate;overflow:hidden}.orbit-art{position:absolute;left:-65px;bottom:-100px;width:600px;height:auto;opacity:.19;z-index:1;pointer-events:none}.orbit-ring{fill:none;stroke:var(--accent);stroke-width:1}.orbit-faint{stroke-dasharray:3 9}.orbit-core,.orbit-satellite circle{fill:var(--accent)}.orbit-satellite{transform-origin:270px 230px;animation:study-orbit 38s linear infinite}.orbit-satellite-slow{animation-duration:65s;animation-direction:reverse}@keyframes study-orbit{to{transform:rotate(360deg)}}
  .orbit-copy{position:relative;z-index:2;min-width:0}.orbit-copy .stage-index{position:static;display:block;margin-bottom:30px;font-size:9px}.orbit-copy h1{font:800 clamp(75px,9.4vw,128px)/.95 var(--font-display);letter-spacing:-.07em;margin:0}.orbit-copy .stage-subtitle{font:700 26px/1.5 var(--font-art,var(--font-display));letter-spacing:.12em;margin:24px 0 0}.orbit-description{font-size:13px;line-height:1.9;color:var(--ink-2);margin:21px 0 0}.orbit-totals{display:flex;flex-wrap:wrap;gap:20px;margin-top:32px;color:var(--ink-3);font-size:10px}.orbit-totals strong{font:500 27px/1 var(--font-display);letter-spacing:-.04em;margin-right:6px;color:var(--accent)}
  .series-atlas{position:relative;z-index:2;min-width:0}.atlas-heading{display:flex;justify-content:space-between;align-items:baseline;flex-wrap:wrap;gap:10px;margin:0 0 18px;font-size:12px;color:var(--ink-2)}.atlas-heading small{font:8px/1.7 var(--font-mono);letter-spacing:.12em;color:var(--ink-3)}.series-atlas ol{list-style:none;display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px;margin:0;padding:0}.series-atlas li{min-width:0}.series-portal{display:grid;grid-template-columns:auto minmax(0,1fr) auto;gap:11px;align-items:start;min-height:106px;padding:19px 15px;border:1px solid var(--line);background:color-mix(in srgb,var(--ground) 69%,transparent);backdrop-filter:blur(8px);color:var(--ink);text-decoration:none;transition:background .25s,border-color .25s,transform .25s;box-sizing:border-box}.series-portal:hover,.series-portal:focus-visible{border-color:color-mix(in srgb,var(--accent) 45%,var(--line));background:color-mix(in srgb,var(--ground) 89%,transparent);transform:translateY(-2px)}.series-portal:focus-visible{outline:1px solid var(--accent);outline-offset:3px}.portal-order{padding-top:4px;font:9px/1.7 var(--font-mono);color:var(--ink-3)}.series-portal h2{font:550 14px/1.65 var(--font-body);margin:0;overflow-wrap:anywhere}.series-portal p{font:8px/1.8 var(--font-mono);letter-spacing:.04em;color:var(--ink-3);margin:7px 0 0;overflow-wrap:anywhere}.portal-count{font:500 20px/1.2 var(--font-display);color:var(--accent);text-align:right}.portal-count small{display:block;font:8px/1.8 var(--font-body);color:var(--ink-3);margin-top:4px}.atlas-empty{border-block:1px solid var(--line);padding:35px 0;margin:0;font-size:14px;line-height:2;color:var(--ink-2)}

  .study-tags{padding-bottom:12px}.study-result{font-size:12px;color:var(--ink-3);margin:0}.chapter-tags{display:block;font-size:10px;line-height:1.7;color:var(--ink-3);margin-top:7px}.series[hidden],[data-study-entry][hidden],.series-navigation a[hidden]{display:none}
  .series{position:relative}.legacy-series-anchor{position:absolute;top:0;scroll-margin-top:120px}

  .series-navigation{display:flex;align-items:center;flex-wrap:wrap;gap:15px 30px;padding:0 0 30px}.series-navigation>span{font-size:11px;color:var(--ink-3);margin-right:auto}.series-navigation a{display:inline-flex;align-items:center;min-height:40px;font:400 12px/1.8 var(--font-mono);color:var(--ink-2);text-decoration:none;letter-spacing:.5px;overflow-wrap:anywhere}.series-navigation a:hover{color:var(--accent)}
  .series{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1.7fr);gap:clamp(36px,5.4vw,75px);padding:55px 0 65px;border-top:1px solid var(--line);scroll-margin-top:120px}.series-intro{align-self:start;position:sticky;top:128px;min-width:0}.series-intro h2{font:700 clamp(24px,2.7vw,33px)/1.45 var(--font-display);letter-spacing:-.045em;margin:22px 0 17px;text-wrap:balance;overflow-wrap:anywhere}.series-intro p{font-size:13px;line-height:2;color:var(--ink-2);max-width:310px;overflow-wrap:anywhere}.series-count{display:block;font:400 11px/1.8 var(--font-mono);color:var(--ink-3);letter-spacing:1px;margin-top:27px}.series ol{list-style:none;margin:0;padding:0;min-width:0}.series li{border-bottom:1px solid var(--line)}.series li:first-child{border-top:1px solid var(--line)}.series li a{display:grid;grid-template-columns:26px minmax(0,1fr);align-items:center;gap:16px;padding:20px 20px 20px 14px;min-height:66px;text-decoration:none;color:var(--ink);transition:background .25s}.chapter-number{font:500 11px var(--font-mono);color:var(--ink-3)}.chapter-title{min-width:0;font-size:14px;line-height:1.9;overflow-wrap:anywhere;transition:color .25s}.series li a:is(:hover,:focus-visible){background:color-mix(in srgb,var(--accent) 6%,var(--ground))}.series li a:focus-visible{outline:1px solid var(--accent);outline-offset:-1px}.series li a:is(:hover,:focus-visible) .chapter-title{color:var(--accent)}
  @media(max-width:760px){.orbit-stage{grid-template-columns:1fr;gap:32px;padding:35px 23px;min-height:0}.orbit-copy h1{font-size:clamp(75px,21vw,110px)}.orbit-art{width:480px;bottom:auto;top:-35px;left:10%}.orbit-copy .stage-index{margin-bottom:25px}.orbit-copy .stage-subtitle{font-size:23px;margin-top:18px}.orbit-description{font-size:12px;margin-top:18px}.orbit-totals{margin-top:23px}.series-atlas ol{gap:10px}.series-portal{padding:15px 12px;gap:8px;min-height:95px}.series-portal h2{font-size:13px}.atlas-heading small{font-size:8px}.series{grid-template-columns:1fr;gap:26px;padding:37px 0 44px}.series-intro{position:static}.series-intro h2{font-size:27px;margin:16px 0 12px}.series-intro p{max-width:100%}.series-count{margin-top:17px}.series-navigation{gap:8px 20px;padding-bottom:26px}.series-navigation>span{width:100%;margin:0}.series-navigation a{font-size:11px}.series li a{grid-template-columns:20px minmax(0,1fr);gap:11px;padding:18px 14px;min-height:62px}.chapter-title{font-size:13px}}
  @media(max-width:500px){.series-atlas ol{grid-template-columns:1fr}.series-portal{min-height:0;padding:16px;align-items:center}.series-portal h2{font-size:14px}.series-portal p{font-size:9px}.portal-count small{display:inline;margin-left:5px}.portal-order{padding:0}.atlas-heading{margin-bottom:13px}}
  :global(html[data-motion=paused]) .orbit-satellite{animation-play-state:paused}:global(html[data-motion=paused]) .series-portal,:global(html[data-motion=paused]) .series li a,:global(html[data-motion=paused]) .chapter-title{transition:none}
  @media(prefers-reduced-motion:reduce){.orbit-satellite{animation:none}.series-portal,.series li a,.chapter-title{transition:none}.series-portal:hover,.series-portal:focus-visible{transform:none}}
</style>
