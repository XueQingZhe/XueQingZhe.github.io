<blue-hour-scene aria-hidden="true" data-renderer="fallback">
  <div class="blue-scene-art">
    <svg data-art-season="day" viewBox="0 0 1672 941" preserveAspectRatio="xMidYMid slice" focusable="false">
      <g data-art-camera>
        <image data-art-image href="/art/blue-hour/seasons/day/complete.webp" x="0" y="0" width="1672" height="941" />
      </g>
    </svg>
    <svg data-art-season="night" viewBox="0 0 1672 941" preserveAspectRatio="xMidYMid slice" focusable="false">
      <defs>
        <filter id="blue-water" filterUnits="userSpaceOnUse" primitiveUnits="userSpaceOnUse" x="0" y="0" width="1672" height="941" color-interpolation-filters="sRGB">
          <feTurbulence data-water-noise type="fractalNoise" baseFrequency=".013 .105" numOctaves="1" seed="9" result="noise" />
          <feImage href="/art/blue-hour/effects/water-region.svg" x="0" y="0" width="1672" height="941" result="water-region" />
          <feComposite in="noise" in2="water-region" operator="in" result="water-noise" />
          <feFlood flood-color="rgb(50%,50%,50%)" result="neutral" />
          <feComposite in="water-noise" in2="neutral" operator="over" result="field" />
          <feDisplacementMap data-water-displacement in="SourceGraphic" in2="field" scale="0" xChannelSelector="R" yChannelSelector="G" />
        </filter>
      </defs>
      <g data-art-camera>
        <image data-art-image href="/art/blue-hour/seasons/night/complete.webp" x="0" y="0" width="1672" height="941" filter="url(#blue-water)" />
      </g>
    </svg>
  </div>
  <canvas></canvas>
</blue-hour-scene>
<style>
  blue-hour-scene{position:absolute;inset:0;display:block;overflow:hidden;pointer-events:none;isolation:isolate}
  canvas,.blue-scene-art{position:absolute;inset:0;width:100%;height:100%;display:block}
  .blue-scene-art{z-index:0;overflow:hidden}
  .blue-scene-art svg{position:absolute;inset:0;display:block;width:100%;height:100%;overflow:hidden}
  blue-hour-scene:not([data-art-ready=true]) [data-art-season=night]{opacity:0}
  :global(html[data-theme=dark]) blue-hour-scene:not([data-art-ready=true]) [data-art-season=day]{opacity:0}
  :global(html[data-theme=dark]) blue-hour-scene:not([data-art-ready=true]) [data-art-season=night]{opacity:1}
  canvas{z-index:1;opacity:0;transition:opacity 1.3s ease}
  [data-renderer=webgl] canvas{opacity:1}
  @media(max-width:700px),(max-aspect-ratio:17/20){
    .blue-scene-art,canvas{inset:390px 0 auto;height:560px;mask-image:linear-gradient(transparent,#000 40px,#000 calc(100% - 65px),transparent)}
    /* Keep a useful crop without JavaScript; the controller refines the viewBox. */
    blue-hour-scene:not([data-art-ready=true]) .blue-scene-art svg{width:995px;left:calc(75% - 746.25px)}
  }
  @media(prefers-reduced-motion:reduce){canvas{transition:none}}
</style>
<script>import '../scripts/blue-hour-scene';</script>
