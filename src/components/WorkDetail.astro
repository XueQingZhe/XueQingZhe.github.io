---
import Base from "../layouts/Base.astro";
import MediaGallery from "../components/MediaGallery.astro";
import Toc from "../components/Toc.astro";
import ReadingTools from "../components/ReadingTools.astro";
import { render } from "astro:content";
import { allArticles, noteUrl, workUrl, workKey } from "../lib/content";
import { labelOf } from "../data/taxonomy";
import "../styles/reading-room.css";

/**
 * 作品详情页，先呈现画面，再展开实现过程。
 *
 * 顺序是刻意的：先给画面，再给事实，最后才是文字。
 *   1. 完整呈现主视觉
 *   2. 一条规格栏：引擎 / 技术 / 角色 / 年份 —— 扫一眼就知道是什么活
 *   3. 媒体画廊：视频、对比滑块、过程图
 *   4. 正文
 *   5. 关联的原理笔记 —— 「先看到效果，再看怎么想的」这条路径的终点
 *   6. 上一个 / 下一个
 */

const { entry, prev=null, next=null } = Astro.props;
const d = entry.data;
const { Content, headings } = await render(entry);

// 作品页的正文常常也是一篇长文（葛叶那篇 24 个小标题），
// 和笔记页用同一个目录组件，超过两个小标题才出现。
const toc = headings.filter((h) => h.depth >= 2 && h.depth <= 4);

// 关联笔记：可能是一篇也可能是好几篇。拿标题出来，不要只给一个 slug。
const noteSlugs = d.notes ? (Array.isArray(d.notes) ? d.notes : [d.notes]) : [];
const noteEntries = await allArticles();
const notes = noteSlugs.map((slug:string) => noteEntries.find(n => n.id === slug)).filter(Boolean);

const specs = [
  { k: "ENGINE", v: d.engine.map((e) => labelOf("engine", e)).join(" · ") },
  { k: "TECH", v: d.tech.map((t) => labelOf("tech", t)).join(" · ") },
  { k: "ROLE", v: d.role.map((r) => labelOf("role", r)).join(" · ") },
  { k: "YEAR", v: String(d.year) },
].filter((s) => s.v);
---

<Base title={d.title} description={d.summary} image={d.cover} article space="work">
  <div class="reading-progress" aria-hidden="true"><span id="case-reading-progress"></span></div>
  <article class="project-case" data-pagefind-body data-pagefind-filter="栏目:作品" data-work-detail={workKey(entry)}>
    <!-- 1 · 头 -->
    <header class="hd reading-room-header">
      <div class="reading-breadcrumb"><a class="back tele" href="/work/" data-work-return><svg viewBox="0 0 22 22" fill="none" aria-hidden="true"><path d="M4 4h6v6H4zM13 4h5v6h-5zM4 13h6v5H4zM13 13h5v5h-5z"/></svg><span>返回作品索引</span></a><span class="reading-edition">WORK / CASE STUDY</span></div>
      <span class="eyebrow reading-kicker"><svg class="reading-emblem" viewBox="0 0 32 32" fill="none" aria-hidden="true"><path d="M6 23V13a10 10 0 0 1 20 0v10M11 23V13a5 5 0 0 1 10 0v10M3 27c5-3 8 3 13 0s8-3 13 0"/><circle cx="21" cy="9" r="1.5"/></svg><span>{d.role.map((r) => labelOf("role", r)).join(" / ") || "Work"}</span></span>
      <h1 data-pagefind-meta="title" data-work-detail-title>{d.title}</h1>
      <p class="sum">{d.summary}</p>
      {d.category&&<p class="case-category"><small>子栏目</small><a data-category-link data-pagefind-filter={`子栏目:${d.category}`} href={`/work/?category=${encodeURIComponent(d.category)}`}>{d.category}</a></p>}
      {d.status === "wip" && <span class="wip tele">● 进行中</span>}
      <ReadingTools scope=".case-body" canonicalPath={workUrl(entry)} />
    </header>

    <!-- 2 · 主视觉 -->
    <div class="hero case-visual">
      <div class:list={['shot',{'shot-video':d.coverVideo}]}>
        {d.coverVideo?<video src={d.coverVideo} poster={d.cover} controls playsinline preload="none" width="1600" height="900" data-work-cover data-work-key={workKey(entry)} data-work-video aria-label={`${d.title} · 作品演示`}><a href={d.coverVideo}>打开作品演示视频</a></video>:<img
          src={d.cover}
          alt={d.coverAlt ?? d.title}
          width="1600"
          height="900"
          data-work-cover
          data-work-key={workKey(entry)}
          fetchpriority="high"
          data-zoom
          tabindex="0"
        />}
      </div>
      <div class="case-visual-caption"><span>{d.coverVideo?'作品演示':'作品主视觉'}</span><span>{d.coverVideo?'点击播放，可全屏观看':'点击画面，查看细节'}</span></div>
    </div>

    <!-- 3 · 规格栏 -->
    <dl class="specs">
      {
        specs.map((s) => (
          <div class="sp">
            <dt class="tele">{s.k}</dt>
            <dd>{s.v}</dd>
          </div>
        ))
      }
      {
        d.repo && (
          <div class="sp">
            <dt class="tele">REPO</dt>
            <dd>
              <a href={d.repo}>GitHub </a>
            </dd>
          </div>
        )
      }
    </dl>

    <!-- 4 · 媒体画廊 -->
    {d.media.length > 0 && (
      <section class="gal">
        <span class="tele-label">过程与细节 / IN FOCUS</span>
        <MediaGallery items={d.media} />
      </section>
    )}

    <!-- 5 · 正文（长文配侧边目录，和笔记页同一套） -->
    <div class="lower" data-toc={toc.length > 2 ? "true" : "false"}>
      {toc.length > 2 && <details class="reading-outline" open><summary><span>案例目录</span><small>{toc.length} 小节</small><svg viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M4 6l4 4 4-4"/></svg></summary><Toc headings={toc} scope=".case-body" label="案例目录"/><div class="reading-place" aria-hidden="true"><span>阅读进度</span><span data-reading-percent>0%</span></div></details>}

      <div class="rcol">
        <div class="prose body case-body"><Content /></div>

        <!-- 6 · 关联笔记 —— 跟着正文列走，不然会和正文差出一个目录的宽度 -->
        {
          notes.length > 0 && (
            <section class="notes">
              <span class="tele-label nh">
                {notes.length > 1 ? `延伸阅读 · ${notes.length} 篇` : "延伸阅读"}
              </span>
              {notes.map((n) => (
                <a class="note" href={noteUrl(n)}>
                  <span class="nt">{n.data.title}</span>
                  {n.data.summary && <span class="ns">{n.data.summary}</span>}
                  <span class="ngo tele">阅读手记 </span>
                </a>
              ))}
            </section>
          )
        }
      </div>
    </div>

    <!-- 7 · 上下篇 -->
    <nav class="pn" aria-label="相邻作品">
      {
        prev ? (
          <a class="p" href={workUrl(prev)}>
            <span class="tele"> 上一件作品</span>
            <span class="pt">{prev.data.title}</span>
          </a>
        ) : (
          <span />
        )
      }
      {
        next && (
          <a class="n" href={workUrl(next)}>
            <span class="tele">下一件作品 </span>
            <span class="pt">{next.data.title}</span>
          </a>
        )
      }
    </nav>
  </article>
</Base>

<script>
  const body=document.querySelector<HTMLElement>('.case-body');
  const bar=document.querySelector<HTMLElement>('#case-reading-progress');
  const percentage=document.querySelector<HTMLElement>('[data-reading-percent]');
  const outline=document.querySelector<HTMLDetailsElement>('.reading-outline');
  const narrow=matchMedia('(max-width: 1149px)');
  if(outline){outline.open=!narrow.matches;narrow.addEventListener('change',()=>{outline.open=!narrow.matches});}
  const toc=document.querySelector('.toc');
  const syncCurrent=()=>toc?.querySelectorAll<HTMLAnchorElement>('a[data-to]').forEach(link=>{if(link.dataset.on==='true')link.setAttribute('aria-current','location');else link.removeAttribute('aria-current');});
  if(toc){new MutationObserver(syncCurrent).observe(toc,{subtree:true,attributes:true,attributeFilter:['data-on']});syncCurrent();}
  if(body&&bar){
    let queued=false;
    function update(){queued=false;const bounds=body!.getBoundingClientRect();const span=Math.max(1,bounds.height-innerHeight*.75);const progress=Math.max(0,Math.min(1,(innerHeight*.15-bounds.top)/span));bar!.style.transform=`scaleX(${progress})`;if(percentage)percentage.textContent=`${Math.round(progress*100)}%`;}
    function schedule(){if(!queued){queued=true;requestAnimationFrame(update);}}
    addEventListener('scroll',schedule,{passive:true});addEventListener('resize',schedule,{passive:true});new ResizeObserver(schedule).observe(body);update();
  }
</script>

<style>
  .case-category{display:flex;align-items:baseline;gap:12px;margin:20px 0 0;font-size:12px;color:var(--ink-2)}.case-category small{font-size:10px;color:var(--ink-3)}.case-category a{color:var(--accent);text-decoration-thickness:1px;text-underline-offset:5px}
  article { padding-block: 54px 0; }

  /* ---- 头 ---- */
  /* 头、正文走阅读列；主视觉和规格栏走中档 —— 两档都居中，
     页面因此是对称的一窄一宽，而不是文字贴左、大图满宽 */
  .hd { max-width: var(--w-text); margin-inline: auto; }
  /* 单独占一行：之前是 inline-block，会和后面的 eyebrow 挤在同一行 */
  .back {
    display: block;
    width: fit-content;
    text-decoration: none;
    margin-bottom: 37px;
    font-size:11px;
    letter-spacing:.6px;
  }
  .back:hover { color: var(--accent); }
  .hd h1 {
    font:750 clamp(28px,4.4vw,60px)/1.4 var(--font-display);
    margin:18px 0 21px;
    letter-spacing:-.045em;
    text-wrap:balance;
  }
  .sum {
    margin: 14px 0 0;
    color: var(--ink-2);
    font-size: 14px;
    line-height: 2;
  }
  .wip { display: inline-block; margin-top: 12px; color: var(--warn); }

  /* ---- 主视觉 ---- */
  .hero { margin-top: 42px; max-width: var(--w-mid); margin-inline: auto; }
  .shot {
    position: relative;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: var(--surface-2);
  }
  .shot img { display:block;width:100%;height:100%;object-fit:contain; }
  .shot video { display:block;width:100%;height:100%;object-fit:contain;background:var(--surface-2); }

  /* ---- 规格栏：扫一眼就知道是什么活 ---- */
  .specs {
    max-width: var(--w-mid);
    margin-inline: auto;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(170px, 100%), 1fr));
    gap: 20px;
    /* 这里原来写的是 margin: 1px 0 0 简写，会把上面的 margin-inline: auto
       一起重置掉 —— 宽度对了但整块贴左。只设纵向 margin。 */
    margin-block: 1px 0;
    background: transparent;
    border-bottom: var(--hair) solid var(--line);
  }
  .sp {
    padding: 22px 0;
  }
  .sp dt { margin-bottom: 9px;font-size:9px;letter-spacing:1.4px; }
  .sp dd {
    margin: 0;
    font-size: 12px;
    color: var(--ink);
    line-height: 1.6;
  }
  .sp a { text-decoration: none; color: var(--accent); }

  /* ---- 画廊 ---- */
  .gal { padding-block: 44px 0; max-width: var(--w-mid); margin-inline: auto; }
  .gal .tele-label { display: block; margin-bottom: 18px;font-size:10px; }

  /* 正文区。有目录时变成「目录 + 正文」两列，整组居中 ——
     和笔记页一致，读者在两种页面之间切换不用重新找位置。 */
  .lower {
    padding-block: 54px 0;
    display: grid;
    grid-template-columns: minmax(0, var(--w-text));
    justify-content: center;
  }
  .lower .rcol { min-width: 0; }
  @media (min-width: 1100px) {
    .lower[data-toc="true"] {
      grid-template-columns: 208px minmax(0, var(--w-text));
      gap: 52px;
      align-items: start;
    }
    .lower[data-toc="true"] :global(.toc) {
      position: sticky;
      top: 118px;
      max-height: calc(100vh - 150px);
      overflow-y: auto;
      overscroll-behavior: contain;
    }
    .lower[data-toc="true"] :global(.toc)::-webkit-scrollbar { width: 3px; }
    .lower[data-toc="true"] :global(.toc)::-webkit-scrollbar-thumb { background: var(--line-2); }
  }
  /* 窄屏单列：目录排到正文后面，别一进来先看一长串小标题 */
  .lower :global(.toc) {
    order: 2;
    margin-top: 40px;
    padding-top: 20px;
    border-top: var(--hair) solid var(--line);
  }
  .lower .rcol { order: 1; }
  @media (min-width: 1100px) {
    .lower[data-toc="true"] :global(.toc) {
      order: 1;
      margin-top: 0;
      padding-top: 0;
      border-top: none;
    }
    .lower[data-toc="true"] .rcol { order: 2; }
  }
  .body { max-width:var(--w-text);font-size:16px;line-height:2;overflow-wrap:anywhere; }
  .lower :global(.toc a){font-size:11px;line-height:1.8;padding-block:6px}.lower :global(.toc li[data-d="4"] a){font-size:10px;color:var(--ink-3)}
  /* 标题锚点：点目录跳过去时，别被顶栏压住 */
  .body :global(h2),
  .body :global(h3),
  .body :global(h4) { scroll-margin-top:120px;font-family:var(--font-display);font-weight:500;letter-spacing:.025em; }
  /* 老站正文几乎每段都是 ***粗斜体***，还原成正常段落，见笔记页同一处注释 */
  .body :global(em strong),
  .body :global(strong em) { font-style: normal; font-weight: 400; }
  .body :global(img) { max-width:100%;height:auto;margin:22px 0; }
  .body :global(p) { margin:0 0 22px;color:var(--ink-2); }
  .body :global(h1), .body :global(h2) {
    font-size:27px;line-height:1.65;margin:50px 0 24px;
    padding-bottom:16px;border-bottom:1px solid var(--line);
  }
  .body :global(h2:first-child){margin-top:0}
  .body :global(h3) { font-size:22px;line-height:1.75;margin:38px 0 18px; }
  /* 第三、四级：不再加粗到抢戏，靠字号和颜色分层就够 */
  .body :global(h4) {
    font-size:18px;
    margin: 24px 0 8px;
    color: var(--ink);
    scroll-margin-top:120px;
  }
  .body :global(h5),
  .body :global(h6) {
    font-size: var(--fs-sm);
    margin: 20px 0 6px;
    color: var(--ink-2);
    font-weight: 700;
    scroll-margin-top: 96px;
  }


  /* ---- 关联笔记 ---- */
  .notes {
    display: flex;
    flex-direction: column;
    gap: 10px;
    margin-top: 52px;
    max-width: var(--w-text);
    margin-inline: auto;
  }
  .rcol { display: flex; flex-direction: column; }
  .nh { color:var(--accent);margin-bottom:12px;font-size:10px; }
  .note {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding:22px 0;
    border-top:1px solid var(--line);
    text-decoration: none;
    color: inherit;
  }
  .nt {
    font-family: var(--font-display);
    font-weight:500;
    font-size:20px;
  }
  .note:hover .nt { color:var(--accent); }
  .ns { color:var(--ink-2);font-size:13px;line-height:1.9; }
  .ngo {
    margin-top: 8px;
    color:var(--ink-3);font-size:10px;
  }
  .note:hover .ngo { color:var(--accent); }

  /* ---- 上下篇 ---- */
  .pn {
    max-width: var(--w-mid);
    margin-inline: auto;
    display: flex;
    justify-content: space-between;
    gap: 20px;
    margin-top: 60px;
    padding-top: 22px;
    border-top: var(--hair) solid var(--line);
  }
  .pn a {
    display: flex;
    flex-direction: column;
    gap: 5px;
    text-decoration: none;
    color: var(--ink-2);
    max-width: 46%;
  }
  .pn .n { text-align: right; align-items: flex-end; }
  .pn a:hover .pt { color:var(--accent); }
  .pt { font:500 17px/1.8 var(--font-display); }
  .pn .tele{font-size:10px;letter-spacing:.5px;margin-bottom:8px}
  .body :global(pre){position:relative;overflow:auto;max-width:100%;padding:25px;margin:28px 0;font-size:12px;line-height:1.85;border:1px solid var(--line);border-radius:0}.body :global(pre code){font-size:inherit}.body :global(table){display:block;width:100%;overflow:auto;border-collapse:collapse;margin:28px 0;font-size:13px}.body :global(th),.body :global(td){border-bottom:1px solid var(--line);padding:12px 16px;text-align:left}.body :global(th){font-weight:500;background:var(--surface-2)}.body :global(blockquote){margin:30px 0;padding:4px 0 4px 25px;border-left:2px solid var(--accent)}.body :global(figure){max-width:100%;margin:32px auto}.body :global(figcaption){font-size:11px;color:var(--ink-3);text-align:center;line-height:1.8}.body :global(.katex-display){overflow:auto;padding-block:8px}
  @media(max-width:650px){article{padding-top:32px}.back{margin-bottom:27px}.hd h1{font-size:27px}.sum{font-size:13px}.hero{margin-top:29px}.specs{grid-template-columns:repeat(2,minmax(0,1fr));gap:0 20px}.sp{padding:17px 0}.sp dd{font-size:11px}.lower{padding-top:35px}.body{font-size:14px}.body :global(h2){font-size:23px}.body :global(h3){font-size:20px}.body :global(pre){padding:20px 15px;font-size:11px}.pt{font-size:14px}}
</style>
