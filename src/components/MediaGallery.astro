---
import CompareSlider from "./CompareSlider.astro";

/**
 * 作品详情页的媒体画廊。
 *
 * 和正文里的图走同一套框架（.fig / .vbox），所以画廊和正文看起来是一套的：
 * 同样的深底细边、同样的 hover rim light、同样点开就能放大。
 *
 * 视频默认不自动播：作品页可能挂好几段录屏，一进页面全都在跑既费流量
 * 也看不过来。用 preload="metadata" 先把首帧和时长拿到，
 * 播放交给用户点。有 poster 就用 poster，没有就用首帧。
 */
interface Props { items: any[] }
const { items = [] } = Astro.props;
---

{
  items.map((m) =>
    m.type === "compare" ? (
      <CompareSlider
        before={m.before}
        after={m.after}
        beforeLabel={m.beforeLabel}
        afterLabel={m.afterLabel}
        caption={m.caption}
      />
    ) : m.type === "video" ? (
      <figure class="fig gfig">
        <div class="vbox">
          <video src={m.src} poster={m.poster} controls preload="metadata" playsinline loop></video>
        </div>
        {m.caption && <figcaption>{m.caption}</figcaption>}
      </figure>
    ) : (
      <figure class="fig gfig">
        <span class="fig-box">
          <img
            src={m.src}
            alt={m.caption ?? ""}
            loading="lazy"
            decoding="async"
            data-zoom
            tabindex="0"
          />
        </span>
        {m.caption && <figcaption>{m.caption}</figcaption>}
      </figure>
    )
  )
}

<style>
  /* 画廊里的图铺满中档列宽，不受正文那套 720 上限约束 —— 这里图就是主角 */
  .gfig { max-width: 100%; margin: 22px 0 0; }
</style>
