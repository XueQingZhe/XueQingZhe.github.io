---
import Base from '../layouts/Base.astro';
---
<Base title="搜索"><section class="search-page"><div class="search-intro"><div class="search-radar" aria-hidden="true"><span></span><span></span><span></span><i></i></div><p class="eyebrow">A THOUGHT IS NEVER LOST</p><h1 data-kinetic data-kinetic-style="wide">FIND<span>寻找一条线索</span></h1><p>输入一个念头，看看它会通向哪里。<br/>搜索手记、教程与作品，例如「高光」「GGX」「RendererFeature」。</p></div><div id="search"></div><p id="search-loading" role="status">正在拾取线索…</p><noscript><p>全文搜索需要 JavaScript。你也可以浏览<a href="/notes/">手记目录</a>和<a href="/tutorials/">学习轨道</a>。</p></noscript></section></Base>
<script is:inline>
  const css=document.createElement('link');css.rel='stylesheet';css.href='/pagefind/pagefind-ui.css';document.head.append(css);
  const script=document.createElement('script');script.src='/pagefind/pagefind-ui.js';
  script.onload=()=>{new PagefindUI({element:'#search',showSubResults:true,translations:{placeholder:'输入关键词',zero_results:'没有找到相关内容'}});document.getElementById('search-loading').hidden=true};
  script.onerror=()=>document.getElementById('search-loading').textContent='搜索暂时无法加载，请稍后重试，或从手记与研习目录继续阅读。';document.head.append(script);
</script>
<style>
 .search-page{max-width:960px;margin:auto;padding-top:40px;min-height:65vh}.search-intro{position:relative;isolation:isolate;padding:25px 0 35px;overflow:hidden}.search-intro h1{font:700 clamp(62px,9vw,115px)/1 var(--font-display);letter-spacing:-7px;margin:28px 0}.search-intro h1>span{display:inline-block;font:400 33px var(--font-art);letter-spacing:2px;margin-left:25px;vertical-align:middle}.search-page p{font-size:12px;color:var(--ink-3);line-height:2;margin-bottom:25px}.search-page .eyebrow{font-size:9px}.search-radar{position:absolute;right:30px;top:0;width:300px;height:300px;opacity:.27;pointer-events:none;z-index:-1}.search-radar span{position:absolute;inset:0;border:1px solid var(--accent);border-radius:50%}.search-radar span:nth-child(2){inset:40px}.search-radar span:nth-child(3){inset:80px}.search-radar i{position:absolute;inset:0;border-top:2px solid var(--accent);border-radius:50%;animation:scan 10s linear infinite}.search-radar:after{content:'';width:8px;height:8px;border-radius:50%;background:var(--accent);position:absolute;left:70px;top:72px;box-shadow:90px 95px 0 var(--accent)}#search{--pagefind-ui-primary:var(--accent);--pagefind-ui-text:var(--ink);--pagefind-ui-background:var(--surface);--pagefind-ui-border:var(--line-2);--pagefind-ui-tag:var(--surface-2);--pagefind-ui-font:var(--font-body);--pagefind-ui-scale:.85;--pagefind-ui-border-radius:3px}@keyframes scan{to{transform:rotate(360deg)}}@media(max-width:600px){.search-page{padding-top:25px}.search-intro h1{letter-spacing:-4px}.search-intro h1>span{font-size:24px;display:block;margin:18px 0 0;letter-spacing:2px}.search-radar{width:190px;height:190px;right:-50px;top:35px}.search-page p{font-size:11px}.search-intro{padding-bottom:20px}}
</style>
