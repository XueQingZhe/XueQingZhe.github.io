---
import { getCollection } from 'astro:content';
import Article from '../components/Article.astro';
export async function getStaticPaths(){
 const entries=(await getCollection('legacy')).filter(n=>!n.data.draft);
 return entries.map(entry=>{const siblings=entries.filter(n=>n.data.series===entry.data.series).sort((a,b)=>entry.data.kind==='tutorial'?a.data.order-b.data.order:a.data.date.valueOf()-b.data.date.valueOf());const i=siblings.findIndex(n=>n.id===entry.id);return {params:{legacy:entry.data.legacyUrl!.replace(/^\/+|\/+$/g,'')},props:{entry,prev:siblings[i-1],next:siblings[i+1]}}});
}
---
<Article {...Astro.props}/>
