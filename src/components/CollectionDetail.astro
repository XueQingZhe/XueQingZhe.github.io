---
import Base from '../layouts/Base.astro';
import ReadingTools from './ReadingTools.astro';
import { render } from 'astro:content';
import { allArticles, topicArticles, noteUrl, workUrl, workKey, articleKindLabel } from '../lib/content';
import { labelOf } from '../data/taxonomy';
import '../styles/reading-room.css';

const {entry}=Astro.props;
const data=entry.data;
const members=topicArticles(entry,await allArticles());
// Existing projects keep their original writing, beneath the directory and collapsed by default.
const {Content}=entry.collection!=='collections'&&entry.body?.trim()?await render(entry):{Content:null};
const count=String(members.length).padStart(2,'0');
---
<Base title={data.title} description={data.summary} image={data.cover} article space="work">
  <article class="collection-detail" data-collection-detail data-work-detail={workKey(entry)} data-work-type="collection" data-pagefind-body data-pagefind-filter="栏目:作品">
    <div class="collection-breadcrumb"><a href="/work/" data-work-return>作品索引</a><span>COLLECTION / {data.year}</span></div>
    <header class="collection-intro">
      <div class="collection-heading">
        <p class="collection-eyebrow"><span class="collection-mark" aria-hidden="true"><i></i><i></i><i></i></span>作品合集 <span>· {members.length} 篇文章</span></p>
        <h1 data-pagefind-meta="title" data-work-detail-title>{data.title}</h1>
        {data.summary&&<p class="collection-summary">{data.summary}</p>}
        <div class="collection-meta"><span>{data.year}</span>{data.engine.map((engine:string)=><span>{labelOf('engine',engine)}</span>)}{data.category&&<a data-category-link data-pagefind-filter={`子栏目:${data.category}`} href={`/work/?category=${encodeURIComponent(data.category)}`}>{data.category}</a>}</div>
        {data.tech.length>0&&<p class="collection-tags" data-pagefind-index-attrs="data-tags" data-tags={data.tech.join(' ')}>{data.tech.map((tag:string)=><span>{labelOf('tech',tag)}</span>)}</p>}
        <ReadingTools canonicalPath={workUrl(entry)} scope=".collection-directory" />
      </div>
      <figure class="collection-cover"><div><img src={data.cover} alt={data.coverAlt||data.title} width="1200" height="900" fetchpriority="high" data-work-cover data-work-key={workKey(entry)} data-collection-cover/></div><figcaption><span>COLLECTED WORKS</span><span>{count} ENTRIES</span></figcaption></figure>
    </header>
    <section class="collection-directory" data-topic-articles aria-labelledby="collection-directory-title">
      <div class="directory-heading"><div><span class="collection-eyebrow">CONTENTS / 按序展开</span><h2 id="collection-directory-title">合集目录</h2></div><span class="directory-count">{count}<small>篇记录</small></span></div>
      {members.length>0?<ol>{members.map((member,index)=><li data-collection-member>
        <a href={noteUrl(member)}>
          <span class="member-number" aria-hidden="true">{String(index+1).padStart(2,'0')}</span>
          <div class="member-copy"><p class="member-kind">{articleKindLabel(member)}{member.data.series&&<span> / {member.data.series}</span>}</p><h3>{member.data.title}</h3>{member.data.summary&&<p class="member-summary">{member.data.summary}</p>}<span class="member-tags">{member.data.tech.map((tag:string)=>labelOf('tech',tag)).join(' · ')}</span></div>
          <span class="member-open">开始阅读</span>
        </a>
      </li>)}</ol>:<p class="collection-empty">这个合集正在整理，新的记录会陆续归入这里。</p>}
    </section>
    {Content&&<details class="collection-context" data-collection-context><summary><span>合集介绍</span><small>展开阅读</small><svg viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M5 8l5 5 5-5"/></svg></summary><div class="prose body collection-context-body"><Content/></div></details>}
    <footer class="collection-footer"><span>每一篇记录，都是整体的一部分。</span><a href="/work/">回到作品索引</a></footer>
  </article>
</Base>
<style>
  .collection-detail{max-width:1120px;margin:0 auto;padding:36px 0 30px}.collection-breadcrumb{display:flex;justify-content:space-between;align-items:center;gap:20px;font:10px/1.7 var(--font-mono);letter-spacing:.09em;color:var(--ink-3);margin:0 0 34px}.collection-breadcrumb a{color:var(--ink-2);text-decoration:none;font-family:var(--font-body)}.collection-breadcrumb a:hover{color:var(--accent)}
  .collection-intro{display:grid;grid-template-columns:minmax(0,1.2fr) minmax(0,1fr);align-items:center;gap:clamp(30px,5vw,75px);padding:22px 0 44px}.collection-heading{min-width:0}.collection-eyebrow{display:flex;align-items:center;gap:10px;color:var(--accent);font:10px/1.7 var(--font-mono);letter-spacing:.09em;margin:0 0 22px}.collection-eyebrow>span:last-child{color:var(--ink-3);letter-spacing:.02em}.collection-mark{display:flex;gap:3px;align-items:end;height:16px}.collection-mark i{height:13px;width:4px;border:1px solid currentColor}.collection-mark i:nth-child(2){height:16px}.collection-mark i:nth-child(3){transform:rotate(-12deg);margin-left:1px}
  h1{font:650 clamp(26px,3.1vw,42px)/1.5 var(--font-display);letter-spacing:-.035em;margin:0 0 23px;text-wrap:balance;overflow-wrap:anywhere}.collection-summary{font-size:14px;line-height:1.95;color:var(--ink-2);margin:0 0 25px;overflow-wrap:anywhere}.collection-meta{display:flex;align-items:baseline;flex-wrap:wrap;gap:8px 18px;font-size:11px;line-height:1.8;color:var(--ink-3)}.collection-meta a{color:var(--accent);text-underline-offset:4px}.collection-tags{display:flex;flex-wrap:wrap;gap:7px 15px;color:var(--ink-3);font-size:10px;line-height:1.7;margin:16px 0 0}
  .collection-cover{margin:0;min-width:0;transform:rotate(1deg)}.collection-cover>div{padding:9px;border:1px solid var(--line);background:var(--surface);box-shadow:0 24px 50px -38px color-mix(in srgb,var(--ink) 45%,transparent)}.collection-cover img{display:block;width:100%;height:auto;aspect-ratio:4/3;object-fit:contain;background:var(--surface-2)}.collection-cover figcaption{display:flex;justify-content:space-between;gap:15px;padding:13px 2px 0;font:9px/1.6 var(--font-mono);letter-spacing:.08em;color:var(--ink-3)}
  .collection-directory{border-top:1px solid var(--line);scroll-margin-top:110px}.directory-heading{display:flex;align-items:center;justify-content:space-between;gap:20px;padding:30px 0 25px}.directory-heading .collection-eyebrow{font-size:9px;margin:0 0 10px}.directory-heading h2{font:500 25px/1.5 var(--font-display);letter-spacing:.08em;margin:0}.directory-count{display:flex;align-items:baseline;gap:10px;color:var(--accent);font:500 35px/1 var(--font-display)}.directory-count small{font:10px/1.5 var(--font-body);color:var(--ink-3)}.collection-directory ol{list-style:none;padding:0;margin:0;border-bottom:1px solid var(--line)}.collection-directory li{border-top:1px solid var(--line)}.collection-directory li>a{display:grid;grid-template-columns:55px minmax(0,1fr) auto;align-items:center;gap:25px;padding:28px 14px 28px 0;text-decoration:none;color:var(--ink);transition:background .25s,padding .25s}.collection-directory li>a:hover,.collection-directory li>a:focus-visible{background:color-mix(in srgb,var(--accent) 5%,transparent);padding-left:12px}.collection-directory li>a:focus-visible{outline:1px solid var(--accent);outline-offset:-1px}.member-number{align-self:start;padding-top:5px;font:500 29px/1 var(--font-display);color:var(--ink-3);letter-spacing:-.055em}.member-copy{min-width:0}.member-kind{font-size:10px;line-height:1.8;letter-spacing:.03em;color:var(--ink-3);margin:0 0 5px}.member-kind span{color:var(--accent)}.member-copy h3{font:550 clamp(17px,1.8vw,22px)/1.65 var(--font-body);letter-spacing:-.015em;margin:0;overflow-wrap:anywhere;transition:color .25s}.collection-directory a:hover h3{color:var(--accent)}.member-summary{font-size:12px;line-height:1.9;color:var(--ink-2);margin:9px 0 0;overflow-wrap:anywhere}.member-tags{display:block;font:10px/1.9 var(--font-mono);color:var(--ink-3);margin-top:9px;overflow-wrap:anywhere}.member-tags:empty{display:none}.member-open{font-size:10px;color:var(--accent);white-space:nowrap}.collection-empty{padding:20px 0 40px;font-size:13px;line-height:1.9;color:var(--ink-3)}
  .collection-context{border-block:1px solid var(--line);margin-top:38px}.collection-context summary{display:flex;align-items:center;gap:18px;padding:23px 0;cursor:pointer;list-style:none;font-size:13px;color:var(--ink-2)}.collection-context summary::-webkit-details-marker{display:none}.collection-context summary small{margin-left:auto;font-size:10px;color:var(--ink-3)}.collection-context summary svg{width:16px;height:16px;stroke:currentColor;stroke-width:1.2;transition:transform .2s}.collection-context[open] summary svg{transform:rotate(180deg)}.collection-context-body{max-width:800px;padding:15px 0 38px;overflow-wrap:anywhere}.collection-footer{display:flex;justify-content:space-between;gap:25px;margin-top:35px;font-size:11px;line-height:1.9;color:var(--ink-3)}.collection-footer a{color:var(--ink-2);text-decoration:none}
  @media(max-width:760px){.collection-detail{padding-top:23px}.collection-breadcrumb{margin-bottom:18px}.collection-intro{grid-template-columns:1fr;gap:28px;padding:16px 0 32px}.collection-eyebrow{margin-bottom:17px}h1{font-size:29px;margin-bottom:18px}.collection-summary{font-size:13px}.collection-cover{max-width:570px;transform:none}.collection-cover img{aspect-ratio:16/9}.directory-heading{padding:26px 0 21px}.directory-heading h2{font-size:23px}.directory-count{font-size:30px}.collection-directory li>a{grid-template-columns:30px minmax(0,1fr);gap:16px;padding:22px 0}.member-number{font-size:23px}.member-open{grid-column:2;font-size:10px;margin-top:-7px}.member-copy h3{font-size:18px}.member-summary{font-size:12px}.collection-footer{flex-wrap:wrap;gap:15px}.collection-context-body{font-size:14px}}
  @media(prefers-reduced-motion:reduce){.collection-directory li>a,.member-copy h3,.collection-context summary svg{transition:none}}
</style>
