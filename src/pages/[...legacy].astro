---
import Article from '../components/Article.astro';
import { allArticles, articleNeighbors } from '../lib/content';
export async function getStaticPaths() {
  const entries = await allArticles();
  return entries.filter(entry => entry.collection === 'legacy' && entry.data.legacyUrl).map(entry => ({
    params:{legacy:entry.data.legacyUrl!.replace(/^\/+|\/+$/g,'')},
    props:{entry,...articleNeighbors(entry,entries)},
  }));
}
---
<Article {...Astro.props}/>
