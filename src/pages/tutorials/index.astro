---
import Base from '../../layouts/Base.astro';
import LivingScene from '../../components/LivingScene.astro';
import '../../styles/editorial-pages.css';
import { allNotes,tutorials,noteUrl,articleSeries,articleOrder,type ArticleEntry } from '../../lib/content';
import { labelOf } from '../../data/taxonomy';
const chapters=await tutorials();
const learning=(await allNotes()).filter(n=>articleSeries(n)==='我独自升级');
const series=[...new Set(chapters.map(articleSeries))].filter(name=>name && name!=='我独自升级');
const seriesMeta=(name:string)=>name.startsWith('Unity')?{engine:'UNITY / URP',description:'在 Unity 中逐步搭建角色渲染：从基础材质、法线与描边，到 Ramp 光照与面部阴影。'}:name.startsWith('UE')?{engine:'UNREAL ENGINE',description:'把角色着色的思路带入 Unreal，记录材质实现、渲染控制与效果调整的过程。'}:name.startsWith('Blender')?{engine:'BLENDER',description:'在 Blender 中理解角色的材质、光照与节点，逐步还原风格化画面的层次。'}:{engine:'STUDY SERIES',description:'把相连的想法整理成系列，沿着实践和理解逐步展开。'};
const solo=[...learning,...chapters.filter(n=>articleSeries(n)==='我独自升级')].sort((a,b)=>articleOrder(a)-articleOrder(b)||a.data.date.valueOf()-b.data.date.valueOf());
const groups:{id:string;name:string;engine:string;description:string;items:ArticleEntry[];solo:boolean}[]=[
 ...(solo.length?[{id:'solo',name:'我独自升级',engine:'LEARNING JOURNAL',description:'从基础出发，记录每一次尝试和理解。主线慢慢展开，支线也会通向新的发现。',items:solo,solo:true}]:[]),
 ...series.map(name=>({id:`series-${name}`,name,...seriesMeta(name),items:chapters.filter(n=>articleSeries(n)===name).sort((a,b)=>articleOrder(a)-articleOrder(b)||a.data.date.valueOf()-b.data.date.valueOf()),solo:false})),
 ...(chapters.some(n=>!articleSeries(n))?[{id:'independent-study',name:'独立研习',engine:'FIELD NOTES',description:'不必先组成系列。一次实验、一个问题，也可以成为探索的起点。',items:chapters.filter(n=>!articleSeries(n)),solo:false}]:[]),
];
// The four satellites preview the directory; the full list grows with every series.
const positions=[{x:115,y:120},{x:405,y:115},{x:425,y:305},{x:145,y:345}];
const orbitalLinks=groups.slice(0,4).map((group,i)=>({href:`#${group.id}`,label:group.name,short:group.name.length>9?group.name.slice(0,8)+'…':group.name,sub:group.engine,...positions[i]}));
const tags=[...new Set(groups.flatMap(group=>group.items.flatMap(n=>n.data.tech)))].sort((a,b)=>a.localeCompare(b,'zh-CN'));
---
<Base title="学习系列" description="从基础知识到角色渲染，沿着系列文章一起学习与实践。">
  <header class="page-stage orbit-stage"><LivingScene variant="study"/><div class="stage-scrim" aria-hidden="true"></div><div class="orbit-copy"><span class="stage-index">03 / KNOWLEDGE IN MOTION</span><h1 data-kinetic data-kinetic-style="wide">ORBIT</h1><p class="stage-subtitle" data-kinetic data-kinetic-style="ink">学习轨道</p><p class="orbit-description">知识不是一条直线。<br/>从任意一个好奇的起点，开始环行。</p></div><nav class="orbit-map" aria-label="选择学习轨道"><svg viewBox="0 0 540 460" role="group" aria-label={`${orbitalLinks.length} 条精选学习轨道`}><circle class="orbit-ring" cx="270" cy="230" r="70"/><ellipse class="orbit-ring" cx="270" cy="230" rx="205" ry="140" transform="rotate(-24 270 230)"/><ellipse class="orbit-ring orbit-faint" cx="270" cy="230" rx="210" ry="190" transform="rotate(35 270 230)"/><path class="orbit-ring orbit-faint" d="M115 120 270 230 405 115 M270 230 425 305 M270 230 145 345"/><g class="orbit-satellite"><circle cx="270" cy="160" r="4"/></g><g class="orbit-satellite orbit-satellite-slow"><circle cx="270" cy="42" r="3"/></g><circle class="orbit-core" cx="270" cy="230" r="8"/><text class="orbit-core-label" x="270" y="258" text-anchor="middle">CURIOUS / ALWAYS</text>{orbitalLinks.map((item,i)=><a href={item.href} aria-label={`阅读${item.label}系列`} class="orbit-point"><title>{item.label}</title><rect x={item.x-77} y={item.y-26} width="154" height="60" rx="7"/><circle cx={item.x} cy={item.y-37} r="5"/><text x={item.x} y={item.y} text-anchor="middle">{item.short}</text><text class="orbit-point-sub" x={item.x} y={item.y+18} text-anchor="middle">0{i+1} / {item.sub}</text></a>)}</svg></nav></header>
  <div data-study-index>
    <nav class="series-navigation" aria-label="学习系列快捷目录"><span>选择一条轨道 · {groups.length} 个系列</span>{groups.map(group=><a href={`#${group.id}`} data-series-link={group.id}>{group.name}</a>)}</nav>
    {tags.length>0&&<div class="editorial-filter study-tags" role="group" aria-label="按标签筛选研习"><button type="button" data-study-tag="" aria-pressed="true">全部标签</button>{tags.map(tag=><button type="button" data-study-tag={tag} aria-pressed="false">{labelOf('tech',tag)}</button>)}</div>}
    <p class="study-result" role="status" aria-live="polite">共 {groups.reduce((sum,g)=>sum+g.items.length,0)} 篇研习记录</p>
    <p class="editorial-empty" data-study-empty hidden>这个标签下还没有研习记录。</p>
    {groups.map((group,index)=><section class="series" id={group.id} data-study-series aria-labelledby={`series-heading-${index}`}><div class="series-intro"><span class="eyebrow">{String(index+1).padStart(2,'0')} / {group.engine}</span><h2 id={`series-heading-${index}`} data-kinetic>{group.name.replace(/^(Unity|UE|Blender)-/,'').replace(/-/g,' · ')}</h2><p>{group.description}</p><span class="series-count">{String(group.items.length).padStart(2,'0')} 篇研习记录</span></div><ol>{group.items.map((n,i)=><li data-reveal data-study-entry data-tech={JSON.stringify(n.data.tech)}><a href={noteUrl(n)}><span class="chapter-number">{String(i+1).padStart(2,'0')}</span><span class="chapter-title">{n.data.title}{n.data.tech.length>0&&<small class="chapter-tags">{n.data.tech.map(tag=>labelOf('tech',tag)).join(' · ')}</small>}</span>{group.solo&&<span class="chapter-kind" data-kind={/支线/.test(n.data.title)?'side':/主线/.test(n.data.title)?'main':'note'}>{/支线/.test(n.data.title)?'支线':/主线/.test(n.data.title)?'主线':'笔记'}</span>}</a></li>)}</ol></section>)}
  </div>
</Base>
<script>
  const index=document.querySelector<HTMLElement>('[data-study-index]');
  if(index){
    const buttons=[...index.querySelectorAll<HTMLButtonElement>('[data-study-tag]')];
    const entries=[...index.querySelectorAll<HTMLElement>('[data-study-entry]')];
    const groups=[...index.querySelectorAll<HTMLElement>('[data-study-series]')];
    const results=index.querySelector<HTMLElement>('.study-result')!;
    const empty=index.querySelector<HTMLElement>('[data-study-empty]')!;
    let tag='';
    function read(){const requested=new URLSearchParams(location.search).get('tag')||'';tag=buttons.some(button=>button.dataset.studyTag===requested)?requested:'';}
    function apply(sync=false){
      let shown=0;
      for(const entry of entries){entry.hidden=!!tag&&!JSON.parse(entry.dataset.tech||'[]').includes(tag);if(!entry.hidden)shown++;}
      for(const group of groups){const count=[...group.querySelectorAll<HTMLElement>('[data-study-entry]')].filter(entry=>!entry.hidden).length;group.hidden=count===0;group.querySelector('.series-count')!.textContent=`${String(count).padStart(2,'0')} 篇研习记录`;const link=[...index!.querySelectorAll<HTMLAnchorElement>('[data-series-link]')].find(link=>link.dataset.seriesLink===group.id);if(link)link.hidden=count===0;}
      for(const button of buttons)button.setAttribute('aria-pressed',String(button.dataset.studyTag===tag));
      results.textContent=shown===entries.length?`共 ${shown} 篇研习记录`:`找到 ${shown} / ${entries.length} 篇研习记录`;empty.hidden=shown>0;
      if(sync){const url=new URL(location.href);tag?url.searchParams.set('tag',tag):url.searchParams.delete('tag');history.replaceState(null,'',url);}
      document.dispatchEvent(new CustomEvent('site:layout'));
    }
    for(const button of buttons)button.addEventListener('click',()=>{tag=button.dataset.studyTag||'';apply(true);});
    for(const link of document.querySelectorAll<HTMLAnchorElement>('.orbit-point'))link.addEventListener('click',()=>{if(tag){tag='';apply(true);}});
    addEventListener('popstate',()=>{read();apply();});read();apply();
  }
</script>
<style>
  .study-tags{padding-bottom:12px}.study-result{font-size:12px;color:var(--ink-3);margin:8px 0 24px}.chapter-tags{display:block;font-size:10px;line-height:1.7;color:var(--ink-3);margin-top:7px}.series[hidden],[data-study-entry][hidden],.series-navigation a[hidden]{display:none}

  .orbit-stage{display:grid;grid-template-columns:1fr 1.1fr;align-items:center;min-height:500px;margin-top:24px;padding:32px 45px}.orbit-copy{position:relative;z-index:2;padding-left:15px}.orbit-copy .stage-index{display:block;margin-bottom:35px}.orbit-copy h1{font:800 clamp(80px,10vw,146px)/.9 var(--font-display);letter-spacing:-.065em;margin:0}.orbit-copy .stage-subtitle{font:700 28px/1.5 var(--font-art,var(--font-display));letter-spacing:.14em;margin:23px 0 0}.orbit-description{font-size:12px;line-height:1.9;color:var(--ink-2);margin:28px 0 0}.orbit-map{position:relative;z-index:2;width:100%}.orbit-map svg{width:100%;height:auto;overflow:visible}.orbit-ring{fill:none;stroke:var(--accent);stroke-width:.8;opacity:.45}.orbit-faint{stroke-dasharray:3 8;opacity:.25}.orbit-core,.orbit-satellite circle{fill:var(--accent)}.orbit-core-label{font:7px var(--font-mono);letter-spacing:1px;fill:var(--ink-3)}.orbit-point{outline-offset:7px}.orbit-point rect{fill:var(--ground);fill-opacity:.85;stroke:var(--line);transition:fill .25s,stroke .25s}.orbit-point circle{fill:var(--accent);stroke:var(--ground);stroke-width:5;paint-order:stroke}.orbit-point text{fill:var(--ink);font:600 12px var(--font-display);letter-spacing:.15px}.orbit-point .orbit-point-sub{fill:var(--ink-3);font:6px var(--font-mono);letter-spacing:.5px}.orbit-point:hover rect,.orbit-point:focus-visible rect{fill:var(--surface-2);stroke:var(--accent)}.orbit-satellite{transform-origin:270px 230px;animation:orbit-turn 25s linear infinite}.orbit-satellite-slow{animation-duration:47s;animation-direction:reverse}@keyframes orbit-turn{to{transform:rotate(360deg)}}
  :global(html[data-motion=paused]) .orbit-satellite{animation-play-state:paused}
  .series-navigation{display:flex;align-items:center;flex-wrap:wrap;gap:15px 30px;padding:0 0 30px}.series-navigation>span{font-size:11px;color:var(--ink-3);margin-right:auto}.series-navigation a{font:400 10px/1.8 var(--font-mono);color:var(--ink-2);text-decoration:none;letter-spacing:.5px}.series-navigation i{font-style:normal;color:var(--accent);margin-left:12px}.series-navigation a:hover{color:var(--accent)}
  .series{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1.7fr);gap:75px;padding:55px 0 65px;border-top:1px solid var(--line);scroll-margin-top:120px}.series-intro{align-self:start;position:sticky;top:128px}.series-intro h2{font:700 clamp(24px,2.7vw,33px)/1.45 var(--font-display);letter-spacing:-.045em;margin:22px 0 17px;text-wrap:balance}.series-intro p{font-size:13px;line-height:2;color:var(--ink-2);max-width:310px}.series-count{display:block;font:400 10px/1.8 var(--font-mono);color:var(--ink-3);letter-spacing:1px;margin-top:27px}.series ol{list-style:none;margin:0;padding:0}.series li{border-bottom:1px solid var(--line)}.series li:first-child{border-top:1px solid var(--line)}.series li a{display:grid;grid-template-columns:26px minmax(0,1fr) 66px;align-items:center;gap:16px;padding:20px 20px 20px 14px;min-height:66px;text-decoration:none;color:var(--ink);transition:background .25s}.chapter-number{font:500 10px var(--font-mono);color:var(--ink-3)}.chapter-title{min-width:0;font-size:13px;line-height:1.9;overflow-wrap:anywhere;transition:color .25s}.chapter-kind{justify-self:end;display:inline-flex;align-items:center;justify-content:center;gap:6px;min-width:52px;padding:4px 9px;border:1px solid var(--line);border-radius:30px;color:var(--ink-2);background:color-mix(in srgb,var(--surface) 60%,transparent);font-size:10px;line-height:1.4;white-space:nowrap}.chapter-kind::before{content:"";width:3px;height:3px;flex:none;border-radius:50%;background:currentColor;opacity:.65}.chapter-kind[data-kind="main"]{color:var(--accent)}.chapter-kind[data-kind="side"]::before{background:transparent;border:1px solid currentColor;box-sizing:border-box;width:4px;height:4px}.series li a:is(:hover,:focus-visible){background:color-mix(in srgb,var(--accent) 6%,var(--ground))}.series li a:focus-visible{outline:1px solid var(--accent);outline-offset:-1px}.series li a:is(:hover,:focus-visible) .chapter-title{color:var(--accent)}
  @media(max-width:760px){.orbit-stage{grid-template-columns:1fr;padding:40px 20px 15px;min-height:0}.orbit-copy{padding-left:6px}.orbit-copy .stage-index{margin-bottom:25px}.orbit-copy h1{font-size:100px}.orbit-copy .stage-subtitle{font-size:23px;margin-top:18px}.orbit-description{font-size:11px;margin-top:18px}.orbit-map{max-width:410px;margin:-12px auto 0}.series{grid-template-columns:1fr;gap:26px;padding:37px 0 44px}.series-intro{position:static}.series-intro h2{font-size:27px;margin:16px 0 12px}.series-intro p{max-width:100%}.series-count{margin-top:17px}.series-navigation{gap:12px 20px;padding-bottom:26px}.series-navigation>span{width:100%;margin:0}.series-navigation a{font-size:9px}.series li a{grid-template-columns:20px minmax(0,1fr) 54px;gap:10px;padding:17px 12px;min-height:62px}.chapter-title{font-size:12px;line-height:1.85}.chapter-kind{min-width:48px;font-size:9px;padding:4px 7px;gap:5px}}
  /* Keep the original reading layout, with enough room around its small labels. */
  .orbit-description{font-size:13px}
  .orbit-point text{font-size:14px}
  .orbit-point .orbit-point-sub{font-size:8px}
  .orbit-core-label{font-size:8px}
  .series-navigation a{font-size:12px;min-height:40px;display:inline-flex;align-items:center}
  .series{gap:clamp(36px,5.4vw,75px)}
  .series-count{font-size:11px}
  .chapter-number{font-size:11px}
  .chapter-title{font-size:14px;line-height:1.9}
  .chapter-kind{font-size:11px;min-width:54px;padding:5px 9px}
  .series li a:not(:has(.chapter-kind)){grid-template-columns:26px minmax(0,1fr)}
  @media(max-width:760px){
    .orbit-copy h1{font-size:clamp(70px,20vw,100px)}
    .orbit-description{font-size:12px}
    .orbit-point text{font-size:16px}
    .orbit-point .orbit-point-sub{display:none}
    .series{gap:26px}
    .series-navigation{gap:8px 20px}
    .series-navigation a{font-size:11px}
    .series li a{grid-template-columns:20px minmax(0,1fr) 56px;gap:11px;padding:18px 14px}
    .series li a:not(:has(.chapter-kind)){grid-template-columns:20px minmax(0,1fr)}
    .chapter-title{font-size:13px}
    .chapter-kind{font-size:10px;min-width:50px;padding:5px 7px}
  }
  :global(html[data-motion=paused]) .series li a,:global(html[data-motion=paused]) .chapter-title{transition:none}
  @media(prefers-reduced-motion:reduce){.series li a,.chapter-title{transition:none}.orbit-satellite{animation:none}}
</style>
