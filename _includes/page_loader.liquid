<!-- _includes/page_loader.liquid -->
<!-- 全局页面加载/转场动画 -->

<!-- 引入字体 -->
<link rel="preconnect" href="https://fonts.loli.net">
<link rel="preconnect" href="https://gstatic.loli.net" crossorigin>
<link href="https://fonts.loli.net/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;1,300;1,400&family=Noto+Serif+SC:wght@400;600;700&display=swap" rel="stylesheet">

<style>
/* ========== 全局加载动画样式 ========== */
.page-loader {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: var(--global-bg-color, #0d1117);
  z-index: 99999;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  transition: opacity 0.8s cubic-bezier(0.4, 0, 0.2, 1), visibility 0.8s;
  overflow: hidden;
}

.page-loader.fade-out {
  opacity: 0;
  visibility: hidden;
  pointer-events: none;
}

.loader-content {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
  animation: loaderFadeIn 0.8s ease forwards;
  position: relative;
  z-index: 2;
}

@keyframes loaderFadeIn {
  from {
    opacity: 0;
    transform: translateY(30px) scale(0.9);
  }
  to {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
}

.loader-logo {
  font-size: clamp(2.2rem, 6vw, 3.5rem);
  font-weight: 700;
  font-family: "Noto Serif SC", "Source Han Serif SC", "STSong", serif;
  background: linear-gradient(135deg, var(--global-text-color, #fff) 20%, var(--global-theme-color, #64b5f6) 80%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
  margin-bottom: 1.5rem;
  letter-spacing: 4px;
  text-shadow: 0 0 60px rgba(var(--global-theme-color-rgb, 100, 181, 246), 0.3);
}

/* 标语容器 */
.loader-quote-container {
  margin-bottom: 3rem;
  opacity: 0;
  animation: quoteAppear 0.8s ease 0.4s forwards;
  text-align: center;
}

/* 主标语 - 中文 */
.loader-quote-main {
  font-size: clamp(1rem, 2.5vw, 1.25rem);
  color: var(--global-text-color-light, rgba(255,255,255,0.7));
  font-family: "Noto Serif SC", "Source Han Serif SC", "STKaiti", "KaiTi", serif;
  font-weight: 400;
  letter-spacing: 3px;
  margin-bottom: 0.8rem;
  line-height: 1.8;
}

/* 副标语 - 外语 */
.loader-quote-sub {
  font-size: clamp(0.75rem, 1.5vw, 0.9rem);
  color: var(--global-text-color-light, rgba(255,255,255,0.4));
  font-family: "Cormorant Garamond", "Times New Roman", Georgia, serif;
  font-weight: 300;
  font-style: italic;
  letter-spacing: 1px;
  line-height: 1.6;
}

@keyframes quoteAppear {
  from {
    opacity: 0;
    transform: translateY(10px);
  }
  to {
    opacity: 0.7;
    transform: translateY(0);
  }
}

/* 进度条容器 - 确保居中 */
.loader-progress-wrapper {
  display: flex;
  justify-content: center;
  width: 100%;
}

.loader-progress {
  width: 220px;
  height: 3px;
  background: rgba(255, 255, 255, 0.08);
  border-radius: 3px;
  overflow: hidden;
  position: relative;
}

.loader-progress-bar {
  height: 100%;
  background: linear-gradient(90deg, 
    var(--global-theme-color, #64b5f6), 
    rgba(var(--global-theme-color-rgb, 100, 181, 246), 0.7),
    var(--global-theme-color, #64b5f6)
  );
  background-size: 200% 100%;
  border-radius: 3px;
  width: 0%;
  animation: progressLoad 1.4s ease forwards, progressShine 1.5s ease-in-out infinite;
  box-shadow: 
    0 0 20px rgba(var(--global-theme-color-rgb, 100, 181, 246), 0.6),
    0 0 40px rgba(var(--global-theme-color-rgb, 100, 181, 246), 0.3);
}

@keyframes progressLoad {
  0% { width: 0%; }
  15% { width: 25%; }
  40% { width: 50%; }
  65% { width: 75%; }
  85% { width: 90%; }
  100% { width: 100%; }
}

@keyframes progressShine {
  0% { background-position: 200% 0; }
  100% { background-position: -200% 0; }
}

/* 背景装饰 */
.loader-bg-decoration {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  pointer-events: none;
  overflow: hidden;
}

/* 中心光晕 */
.loader-glow {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 500px;
  height: 500px;
  background: radial-gradient(circle, rgba(var(--global-theme-color-rgb, 100, 181, 246), 0.08) 0%, transparent 70%);
  border-radius: 50%;
  animation: glowPulse 3s ease-in-out infinite;
}

@keyframes glowPulse {
  0%, 100% { transform: translate(-50%, -50%) scale(1); opacity: 0.6; }
  50% { transform: translate(-50%, -50%) scale(1.3); opacity: 1; }
}

/* 浮动粒子 */
.loader-particle {
  position: absolute;
  width: 4px;
  height: 4px;
  background: var(--global-theme-color, #64b5f6);
  border-radius: 50%;
  opacity: 0.4;
}

.loader-particle:nth-child(1) {
  top: 15%;
  left: 10%;
  animation: particleFloat1 4s ease-in-out infinite;
}
.loader-particle:nth-child(2) {
  top: 75%;
  left: 15%;
  animation: particleFloat2 5s ease-in-out infinite 0.5s;
}
.loader-particle:nth-child(3) {
  top: 20%;
  right: 15%;
  animation: particleFloat1 4.5s ease-in-out infinite 1s;
}
.loader-particle:nth-child(4) {
  top: 70%;
  right: 10%;
  animation: particleFloat2 5.5s ease-in-out infinite 0.3s;
}
.loader-particle:nth-child(5) {
  top: 50%;
  left: 5%;
  animation: particleFloat1 6s ease-in-out infinite 0.7s;
}
.loader-particle:nth-child(6) {
  top: 40%;
  right: 8%;
  animation: particleFloat2 5s ease-in-out infinite 1.2s;
}

@keyframes particleFloat1 {
  0%, 100% { 
    transform: translateY(0) translateX(0) scale(1); 
    opacity: 0.3; 
  }
  50% { 
    transform: translateY(-30px) translateX(15px) scale(1.5); 
    opacity: 0.7; 
  }
}

@keyframes particleFloat2 {
  0%, 100% { 
    transform: translateY(0) translateX(0) scale(1); 
    opacity: 0.3; 
  }
  50% { 
    transform: translateY(25px) translateX(-10px) scale(1.3); 
    opacity: 0.6; 
  }
}

/* 顶部和底部渐变线 */
.loader-line-top,
.loader-line-bottom {
  position: absolute;
  left: 0;
  width: 100%;
  height: 1px;
  background: linear-gradient(90deg, 
    transparent 0%, 
    rgba(var(--global-theme-color-rgb, 100, 181, 246), 0.3) 50%, 
    transparent 100%
  );
}

.loader-line-top {
  top: 20%;
  animation: lineSlide 3s ease-in-out infinite;
}

.loader-line-bottom {
  bottom: 20%;
  animation: lineSlide 3s ease-in-out infinite 1.5s;
}

@keyframes lineSlide {
  0%, 100% { opacity: 0.3; transform: scaleX(0.5); }
  50% { opacity: 0.6; transform: scaleX(1); }
}

/* 页面内容初始状态 */
.page-content-wrapper {
  opacity: 0;
  transition: opacity 0.6s ease 0.1s;
}

.page-content-wrapper.loaded {
  opacity: 1;
}

/* 移动端适配 */
@media (max-width: 768px) {
  .loader-logo {
    font-size: 2rem;
    letter-spacing: 2px;
  }
  .loader-quote-main {
    font-size: 0.95rem;
    letter-spacing: 2px;
  }
  .loader-quote-sub {
    font-size: 0.7rem;
  }
  .loader-quote-container {
    margin-bottom: 2.5rem;
    padding: 0 1rem;
  }
  .loader-progress {
    width: 180px;
  }
  .loader-glow {
    width: 300px;
    height: 300px;
  }
}
</style>

<div class="page-loader" id="globalPageLoader">
  <!-- 背景装饰 -->
  <div class="loader-bg-decoration">
    <div class="loader-glow"></div>
    <div class="loader-particle"></div>
    <div class="loader-particle"></div>
    <div class="loader-particle"></div>
    <div class="loader-particle"></div>
    <div class="loader-particle"></div>
    <div class="loader-particle"></div>
    <div class="loader-line-top"></div>
    <div class="loader-line-bottom"></div>
  </div>
  
  <!-- 主要内容 -->
  <div class="loader-content">
    <div class="loader-logo">{{ site.first_name }} {{ site.last_name | default: "轻遮" }}</div>
    <div class="loader-quote-container" id="loaderQuote">
      <div class="loader-quote-main" id="quoteMain"></div>
      <div class="loader-quote-sub" id="quoteSub"></div>
    </div>
    <div class="loader-progress-wrapper">
      <div class="loader-progress">
        <div class="loader-progress-bar"></div>
      </div>
    </div>
  </div>
</div>

<script>
(function() {
  // 名言库 - 中文 + 外语对照
  const quotes = [
    {
      main: "代码如诗，渲染如画",
      sub: "Code is poetry, rendering is art."
    },
    {
      main: "什么是恶？凡是源于虚弱的东西都是恶",
      sub: "Was ist schlecht? — Alles, was aus der Schwäche stammt."
    },
    {
      main: "凡不能毁灭我的，必使我强大",
      sub: "What does not kill me makes me stronger."
    },
    {
      main: "技术与美学的交汇点",
      sub: "Where technology meets aesthetics."
    },
    {
      main: "追光者永不止步",
      sub: "Those who chase the light never stop."
    },
    {
      main: "在像素中寻找无限可能",
      sub: "Finding infinite possibilities in pixels."
    },
    {
      main: "保持饥饿，保持愚蠢",
      sub: "Stay hungry, Stay foolish."
    },
    {
      main: "学习永不疲倦心灵",
      sub: "Learning never exhausts the mind. — Leonardo da Vinci"
    },
    {
      main: "预测未来最好的方式就是创造它",
      sub: "The best way to predict the future is to create it."
    },
    {
      main: "简约是终极的复杂",
      sub: "Simplicity is the ultimate sophistication."
    },
    {
      main: "每一帧都是艺术的追求",
      sub: "Every frame is a pursuit of art."
    },
    {
      main: "吾生也有涯，而知也无涯",
      sub: "Life is finite, but knowledge is infinite. — Zhuangzi"
    },
    {
      main: "路漫漫其修远兮，吾将上下而求索",
      sub: "The road ahead is long; I shall seek high and low. — Qu Yuan"
    },
    {
      main: "工欲善其事，必先利其器",
      sub: "A craftsman must sharpen his tools first."
    },
    {
      main: "光影是渲染的灵魂",
      sub: "Light and shadow are the soul of rendering."
    }
  ];

  // 根据页面类型选择相关语句
  const pageQuotes = {
    'tutorials': [
      {
        main: "知识的积累，从这里开始",
        sub: "The accumulation of knowledge begins here."
      },
      {
        main: "学而不思则罔，思而不学则殆",
        sub: "Learning without thought is labor lost. — Confucius"
      },
      {
        main: "千里之行，始于足下",
        sub: "A journey of a thousand miles begins with a single step."
      }
    ],
    'blog': [
      {
        main: "记录思考，分享成长",
        sub: "Record thoughts, share growth."
      },
      {
        main: "文字是思想的结晶",
        sub: "Words are the crystallization of thoughts."
      }
    ],
    'projects': [
      {
        main: "实践出真知",
        sub: "Practice brings true knowledge."
      },
      {
        main: "纸上得来终觉浅，绝知此事要躬行",
        sub: "What you learn on paper is superficial; true understanding requires practice."
      }
    ]
  };

  // 获取当前页面类型
  const path = window.location.pathname;
  let selectedQuotes = quotes;
  
  for (const [key, value] of Object.entries(pageQuotes)) {
    if (path.includes(key)) {
      selectedQuotes = [...value, ...quotes.slice(0, 5)];
      break;
    }
  }

  // 随机选择一条语句
  const randomQuote = selectedQuotes[Math.floor(Math.random() * selectedQuotes.length)];
  
  // 设置语句
  const quoteMain = document.getElementById('quoteMain');
  const quoteSub = document.getElementById('quoteSub');
  
  if (quoteMain && quoteSub) {
    quoteMain.textContent = randomQuote.main;
    quoteSub.textContent = randomQuote.sub;
  }

  // 页面加载完成后隐藏 loader
  function hideLoader() {
    const loader = document.getElementById('globalPageLoader');
    const content = document.querySelector('.page-content-wrapper');
    
    if (loader) {
      loader.classList.add('fade-out');
    }
    if (content) {
      content.classList.add('loaded');
    }
    
    // 完全移除 loader
    setTimeout(function() {
      if (loader) {
        loader.style.display = 'none';
      }
    }, 800);
  }

  // 监听真实的页面加载完成事件，而非固定延迟
  if (document.readyState === 'complete') {
    // 页面已经加载完毕（脚本较晚执行时）
    hideLoader();
  } else {
    window.addEventListener('load', hideLoader);
  }

  // 保底机制：最多等待 3 秒，防止某个资源加载失败时 loader 永远卡住
  setTimeout(hideLoader, 3000);
})();
</script>
