<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/aplayer/dist/APlayer.min.css">
<script src="https://cdn.jsdelivr.net/npm/aplayer/dist/APlayer.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/meting@2/dist/Meting.min.js"></script>

<div id="aplayer-container">
  <meting-js
    server="netease"
    type="playlist" 
    id="2072624795"
    fixed="true" 
    mini="true"
    theme="#212121"
    loop="all"
    order="list"
    preload="auto"
    list-folded="true">
  </meting-js>
</div>

<style>
  /* ── al-folio UI 层级修复 ── */
  .aplayer.aplayer-fixed {
    z-index: 10000 !important;
  }

  /* ── 悬浮按钮：深色 + 微边框 ── */
  .aplayer.aplayer-fixed.aplayer-narrow .aplayer-body {
    background: #111111 !important;
    border-radius: 50% !important;
    box-shadow: 0 0 0 1px rgba(255,255,255,0.1),
                0 4px 20px rgba(0,0,0,0.4) !important;
  }

  /* ── 展开面板：深色卡片风格 ── */
  .aplayer:not(.aplayer-narrow) .aplayer-body {
    background: #111111 !important;
    border-radius: 12px 12px 0 0 !important;
  }

  /* ── 进度条：纤细、低对比度 ── */
  .aplayer .aplayer-bar-wrap .aplayer-bar {
    height: 2px !important;
    background: rgba(255,255,255,0.08) !important;
  }
  .aplayer .aplayer-bar-wrap .aplayer-played {
    background: rgba(255,255,255,0.7) !important;
  }
  .aplayer .aplayer-bar-wrap .aplayer-thumb {
    background: #fff !important;
    width: 8px !important;
    height: 8px !important;
    border-radius: 50% !important;
    top: -3px !important;
  }

  /* ── 歌曲信息：更细腻的字色 ── */
  .aplayer .aplayer-info .aplayer-music .aplayer-title {
    color: rgba(255,255,255,0.9) !important;
    font-size: 13px !important;
  }
  .aplayer .aplayer-info .aplayer-music .aplayer-author {
    color: rgba(255,255,255,0.35) !important;
    font-size: 11px !important;
  }

  /* ── 歌单：极细分割线 ── */
  .aplayer .aplayer-list ol li {
    border-bottom: 0.5px solid rgba(255,255,255,0.05) !important;
  }
  .aplayer .aplayer-list ol li.aplayer-list-light {
    background: rgba(255,255,255,0.06) !important;
  }
  .aplayer .aplayer-list ol li span {
    color: rgba(255,255,255,0.4) !important;
  }
  .aplayer .aplayer-list ol li .aplayer-list-title {
    color: rgba(255,255,255,0.75) !important;
  }

  /* ── 控制按钮图标颜色 ── */
  .aplayer .aplayer-info .aplayer-controller .aplayer-time .aplayer-icon path {
    fill: rgba(255,255,255,0.5) !important;
  }
  .aplayer .aplayer-info .aplayer-controller .aplayer-time .aplayer-icon:hover path {
    fill: rgba(255,255,255,0.9) !important;
  }
</style>