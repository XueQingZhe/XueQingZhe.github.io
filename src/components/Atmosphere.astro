---
// Decorative light over the hero painting. Its CSS layer survives unavailable WebGL.
---

<div class="atmosphere" aria-hidden="true">
  <div class="atmosphere-fallback"></div>
  <site-atmosphere><canvas></canvas></site-atmosphere>
</div>

<style>
  .atmosphere {
    position: absolute;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
    border-radius: inherit;
    isolation: isolate;
  }
  site-atmosphere,
  canvas,
  .atmosphere-fallback {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
  }
  canvas { opacity: 0; transition: opacity 1.2s ease; }
  .atmosphere[data-renderer="webgl"] canvas { opacity: 1; }
  .atmosphere-fallback {
    background:
      radial-gradient(ellipse at 28% 3%, rgb(255 222 149 / .13), transparent 56%),
      linear-gradient(123deg, transparent 36%, rgb(253 234 180 / .07) 40%, transparent 47%);
    transition: opacity 1.8s ease;
  }
  :global(html[data-theme="dark"]) .atmosphere-fallback { opacity: .17; }
  @media (prefers-reduced-motion: reduce) {
    canvas,
    .atmosphere-fallback { transition: none; }
  }
</style>

<script>
  import '../scripts/atmosphere';
</script>
