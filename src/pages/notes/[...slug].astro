---
import { detailPages } from '../../lib/content';
import Article from '../../components/Article.astro';
import WorkDetail from '../../components/WorkDetail.astro';
export async function getStaticPaths() {
  return (await detailPages()).filter(({url})=>url.startsWith('/notes/')).map(({url,...props})=>({
    params:{slug:decodeURIComponent(url.slice('/notes/'.length).replace(/\/$/,''))},props,
  }));
}
---
{Astro.props.isWork ? <WorkDetail {...Astro.props}/> : <Article {...Astro.props}/>}
