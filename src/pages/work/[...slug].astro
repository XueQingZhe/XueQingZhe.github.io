---
import WorkDetail from '../../components/WorkDetail.astro';
import { allWork } from '../../lib/content';
export async function getStaticPaths() {
  const items = await allWork();
  return items.flatMap((entry,i) => entry.collection === 'work' ? [{params:{slug:entry.id},props:{entry,prev:items[i-1],next:items[i+1]}}] : []);
}
---
<WorkDetail {...Astro.props}/>
